MISTRAL_API_KEY=
PINECONE_API_KEY=
PINECONE_INDEX_NAME=legal-rag
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
# Only needed for the optional server-side answer generator (/api/plugin/ask
# and the web chat). Memory-only search/ingest does not use OpenRouter.
OPENROUTER_API_KEY=
OPENROUTER_CHAT_MODEL=deepseek/deepseek-v4.1-flash
MONGODB_URI=
JWT_SECRET=

R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=legalpdf
R2_PUBLIC_URL=

# ChatGPT plugin
# Public HTTPS origin used in the manifest and OpenAPI server URL.
PLUGIN_BASE_URL=https://www.llmlite.xyz
# Token supplied by OpenAI when you submit/verify the plugin.
CHATGPT_PLUGIN_VERIFICATION_TOKEN=
# Exact token shown by the OpenAI plugin portal for domain verification.
OPENAI_APPS_CHALLENGE_TOKEN=
PLUGIN_CONTACT_EMAIL=support@llmlite.xyz
PLUGIN_LEGAL_URL=https://www.llmlite.xyz/legal
